APP_NAME=WireGuard Manager
DATABASE_URL=sqlite:///./data/wireguard.db

WIREGUARD_INTERFACE=wg0
WIREGUARD_CONFIG_PATH=/etc/wireguard/wg0.conf
WIREGUARD_SERVER_PUBLIC_IP=2.25.222.27
WIREGUARD_SERVER_PORT=443
WIREGUARD_SERVER_VPN_IP=10.104.5.1
WIREGUARD_NETWORK=10.104.5.0/24
WIREGUARD_DNS=1.1.1.1, 1.0.0.1
WIREGUARD_MTU=1280
WIREGUARD_SERVER_PUBLIC_KEY=your_server_public_key_here

VLESS_ENABLED=true
VLESS_ADDRESS=2.25.222.27
VLESS_PORT=443
VLESS_PATH=/vless-ws
VLESS_NETWORK=ws
VLESS_SECURITY=tls
VLESS_SNI=2.25.222.27
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json